# Copy this file to `.env` next to docker-compose.yml and edit it.
#
#   cp .env.example .env
#
# Everything here has a working default except DB_ROOT_PASSWORD, which has to
# be set, and REALM_ADDRESS, which has to be set for anyone but you to connect.

###############################################################################
# Images
###############################################################################

# Where the prebuilt images are pulled from and which tag to use.
# `latest` follows the newest successful build of the Playerbot branch; pin a
# commit sha (the workflow also tags every build with it) for reproducibility.
AC_IMAGE_REGISTRY=ghcr.io/prinzwalium/azerothcore-wotlk
AC_IMAGE_TAG=latest

###############################################################################
# Database
###############################################################################

# Required. Used by every server component to reach MySQL.
DB_ROOT_PASSWORD=

# MySQL is only exposed on the loopback interface by default. Use `3306` to
# publish it on all interfaces, or comment the line out and remove the ports
# entry if it should not be reachable from the host at all.
DB_EXTERNAL_PORT=127.0.0.1:3306

# Raise this if you have the RAM. The world database plus a few hundred bots
# are much happier with 2-4G than with the MySQL default of 128M.
DB_BUFFER_POOL_SIZE=1G
DB_MAX_CONNECTIONS=256

###############################################################################
# Realm
###############################################################################

# The address game clients use to reach this server: a public IP or hostname.
# On first start this is written into the realmlist table. If it is left empty
# the realm keeps pointing at 127.0.0.1 and only a client on this same machine
# will get past the realm selection screen.
REALM_ADDRESS=
REALM_NAME=AzerothCore

# Published ports. 3724 (auth) and 8085 (world) must be reachable by clients.
AUTH_EXTERNAL_PORT=3724
WORLD_EXTERNAL_PORT=8085
# SOAP stays on loopback unless you know you need it remotely.
SOAP_EXTERNAL_PORT=127.0.0.1:7878

###############################################################################
# First admin account
###############################################################################

# Created on first start, with GM level 3 (full admin). Leave either value
# empty to skip it and create the account by hand instead.
# The account is only ever created, never updated: changing the password here
# after the first start has no effect, use `.account set password` in-game or
# the worldserver console for that.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_GMLEVEL=3

###############################################################################
# Playerbots
###############################################################################

# Master switch for the bot AI.
PLAYERBOTS_ENABLED=1

# Whether the random bot population logs itself in automatically.
PLAYERBOTS_RANDOM_BOT_AUTOLOGIN=1

# How many random bots populate the world. The module default is 500, which is
# a lot of CPU and a long first start (every bot is a character that has to be
# generated). 100 is a comfortable starting point; raise it once you know how
# the machine copes.
PLAYERBOTS_MIN_RANDOM_BOTS=100
PLAYERBOTS_MAX_RANDOM_BOTS=100

# Any other option from playerbots.conf can be set here too, by adding it to
# the ac-worldserver environment in docker-compose.yml. The naming rule is
# AiPlayerbot.SomeOptionName -> AC_AI_PLAYERBOT_SOME_OPTION_NAME.

###############################################################################
# Bots banking gathered materials
###############################################################################

# Bots already gather: the `gather` strategy is on by default and they are
# generated with herbalism, mining and skinning. What they do not do is bank any
# of it -- unwanted trade goods are classified as vendor trash and sold, or
# destroyed when bags fill.
#
# With this on, a bot carrying materials that walks past a guild vault it may
# deposit into empties them into the first tab, and those materials are marked
# "keep" so they are never vendored or destroyed in the meantime.
#
# Note this is proximity based: bots bank when their wandering takes them past a
# vault, they do not make a trip. Yield depends on how much time your bots spend
# in cities.
PLAYERBOTS_BANK_GATHERED=0

# Which ITEM_CLASS_TRADE_GOODS subclasses count as "gathered material".
# The default is what the gathering professions produce:
#   6 = leather and hides, 7 = ore, stone and bars, 9 = herbs
# Others you may want: 5 = cloth, 10 = elemental, 12 = enchanting materials.
# Careful: a guild bank tab holds 98 stacks, and widening this fills it fast.
PLAYERBOTS_BANK_GATHERED_SUBCLASSES=6,7,9

# How many matching stacks a bot must be carrying before it bothers banking.
PLAYERBOTS_BANK_GATHERED_MIN_ITEMS=4

# Strategies applied to every random bot, on top of their defaults, in the
# module's own "+add,-remove" syntax. The banking strategy is NOT on by default,
# so this is what actually switches it on for the bot population:
#
#   PLAYERBOTS_RANDOM_BOT_NONCOMBAT_STRATEGIES=+bank gathered
#
# Leave empty to keep the module's defaults.
PLAYERBOTS_RANDOM_BOT_NONCOMBAT_STRATEGIES=

###############################################################################
# Talking to bots in plain language (Ollama)
###############################################################################

# Translates what you type at a bot into one of its own commands, using a local
# Ollama instance. "wait here while I tame this wolf" becomes `stay`; "ok come
# on" becomes `follow`.
#
# This is deliberately a translator, not a chatbot: the model may only emit
# commands from AI_COMMANDS below, and anything else it produces is dropped. A
# misread sentence is a no-op, never a surprise action.
#
# Start the Ollama container alongside the rest, and pull a model into it once:
#
#   docker compose --profile ai up -d
#   docker compose exec ac-ollama ollama pull llama3.1:8b
#
# Needs an NVIDIA GPU and the NVIDIA container runtime for replies fast enough
# to feel natural. On CPU a reply takes long enough that you will have moved on.
AI_ENABLED=0

AI_HOST=ac-ollama
AI_PORT=11434

# An 8B instruct model at Q4 fits comfortably in 12 GB and is plenty: the task
# is picking one command, not writing prose. Check what tags exist on Ollama
# rather than trusting this default to still be current.
AI_MODEL=llama3.1:8b

# Which chat gets translated. `whisper` and `party` are the useful ones.
# `guild` and `say` are accepted but noisy, and mean more load on the model.
AI_COMMAND_SCOPES=whisper,party

# Who may drive a bot this way:
#   master -> only the player the bot belongs to (default, and the safe answer)
#   group  -> anyone grouped with the bot
# Use `group` only if you trust everyone you play with not to steer your bots.
AI_COMMAND_FROM=master

# Give up on a reply after this long, and do not let more than this many
# requests be in flight at once. Both exist to stop a slow model from turning
# into a queue of stale orders.
AI_TIMEOUT_MS=8000
AI_WORKERS=2

# Minimum gap between translations for any one bot. With a party of bots, one
# message would otherwise fan out into several requests at once.
AI_COOLDOWN_MS=3000

# Whisper back the command that was understood, so a misread is obvious.
AI_CONFIRM=1

# The full option set (including AI_COMMANDS, which is the allow list the model
# is held to) is documented in apps/docker/playerbots/README.md. Add any of them
# to the ac-worldserver environment in docker-compose.yml using the same naming
# rule: AiPlayerbot.Ai.SomeOption -> AC_AI_PLAYERBOT_AI_SOME_OPTION.

###############################################################################
# Auction house bot
###############################################################################

# mod-ah-bot-plus posts auctions as real characters, so it needs at least one.
# List the character names to create here, comma separated, and the first start
# creates them on a dedicated account and points the module at them. These names
# are what players see as the seller in the auction house, so pick ones that fit
# the realm.
#
# Leave empty to skip the auction house bot entirely.
#
# Rules: letters only, 2-12 characters, and a name that is already taken is
# reused rather than recreated.
#
# Keep the list to 10 names or fewer: they all go on one account, and
# CharactersPerRealm in worldserver.conf allows 10 per account (the bootstrap
# inserts them directly, so nothing rejects the 11th -- it just leaves the
# account in a state the client cannot show).
#
# More names do not mean more auctions either. Throughput is AHBOT_ITEMS_PER_CYCLE,
# which is shared across all of them; extra names only vary who appears as the
# seller, and each one costs a Player object rebuilt on every cycle.
AHBOT_CHARACTER_NAMES=Auctioneer

# The account that owns those characters. It gets a random password and no GM
# level; it exists only to own them and is never logged into.
AHBOT_ACCOUNT_USERNAME=AHBOT

# The seller stocks the auction house; the buyer bids on what players list.
AHBOT_SELLER_ENABLED=1
AHBOT_BUYER_ENABLED=1

# How many items get listed per cycle. The auction house takes a few hours to
# fill at the default; raise it to populate faster at the cost of more work per
# tick.
AHBOT_ITEMS_PER_CYCLE=150

# Everything else in mod_ahbot.conf (pricing, category proportions, stack sizes)
# follows the same naming rule as above:
# AuctionHouseBot.SomeOption -> AC_AUCTION_HOUSE_BOT_SOME_OPTION.
# The one exception is AuctionHouseBot.GUIDs, which is managed automatically.
