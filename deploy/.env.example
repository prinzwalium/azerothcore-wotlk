# Copy this file to `.env` next to docker-compose.yml and edit it.
#
#   cp .env.example .env
#
# Everything here has a working default except DB_ROOT_PASSWORD, which has to
# be set, and REALM_ADDRESS, which has to be set for anyone but you to connect.

###############################################################################
# Images
###############################################################################

# Where the prebuilt images are pulled from and which tag to use.
# `latest` follows the newest successful build of the Playerbot branch; pin a
# commit sha (the workflow also tags every build with it) for reproducibility.
AC_IMAGE_REGISTRY=ghcr.io/prinzwalium/azerothcore-wotlk
AC_IMAGE_TAG=latest

###############################################################################
# Database
###############################################################################

# Required. Used by every server component to reach MySQL.
DB_ROOT_PASSWORD=

# MySQL is only exposed on the loopback interface by default. Use `3306` to
# publish it on all interfaces, or comment the line out and remove the ports
# entry if it should not be reachable from the host at all.
DB_EXTERNAL_PORT=127.0.0.1:3306

# Raise this if you have the RAM. The world database plus a few hundred bots
# are much happier with 2-4G than with the MySQL default of 128M.
DB_BUFFER_POOL_SIZE=1G
DB_MAX_CONNECTIONS=256

###############################################################################
# Realm
###############################################################################

# The address game clients use to reach this server: a public IP or hostname.
# On first start this is written into the realmlist table. If it is left empty
# the realm keeps pointing at 127.0.0.1 and only a client on this same machine
# will get past the realm selection screen.
REALM_ADDRESS=
REALM_NAME=AzerothCore

# Published ports. 3724 (auth) and 8085 (world) must be reachable by clients.
AUTH_EXTERNAL_PORT=3724
WORLD_EXTERNAL_PORT=8085
# SOAP stays on loopback unless you know you need it remotely.
SOAP_EXTERNAL_PORT=127.0.0.1:7878

###############################################################################
# First admin account
###############################################################################

# Created on first start, with GM level 3 (full admin). Leave either value
# empty to skip it and create the account by hand instead.
# The account is only ever created, never updated: changing the password here
# after the first start has no effect, use `.account set password` in-game or
# the worldserver console for that.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_GMLEVEL=3

###############################################################################
# Playerbots
###############################################################################

# Master switch for the bot AI.
PLAYERBOTS_ENABLED=1

# Whether the random bot population logs itself in automatically.
PLAYERBOTS_RANDOM_BOT_AUTOLOGIN=1

# How many random bots populate the world. The module default is 500, which is
# a lot of CPU and a long first start (every bot is a character that has to be
# generated). 100 is a comfortable starting point; raise it once you know how
# the machine copes.
PLAYERBOTS_MIN_RANDOM_BOTS=100
PLAYERBOTS_MAX_RANDOM_BOTS=100

# Any other option from playerbots.conf can be set here too, by adding it to
# the ac-worldserver environment in docker-compose.yml. The naming rule is
# AiPlayerbot.SomeOptionName -> AC_AI_PLAYERBOT_SOME_OPTION_NAME.

###############################################################################
# Auction house bot
###############################################################################

# mod-ah-bot-plus posts auctions as real characters, so it needs at least one.
# List the character names to create here, comma separated, and the first start
# creates them on a dedicated account and points the module at them. These names
# are what players see as the seller in the auction house, so pick ones that fit
# the realm.
#
# Leave empty to skip the auction house bot entirely.
#
# Rules: letters only, 2-12 characters, and a name that is already taken is
# reused rather than recreated.
AHBOT_CHARACTER_NAMES=Auctioneer

# The account that owns those characters. It gets a random password and no GM
# level; it exists only to own them and is never logged into.
AHBOT_ACCOUNT_USERNAME=AHBOT

# The seller stocks the auction house; the buyer bids on what players list.
AHBOT_SELLER_ENABLED=1
AHBOT_BUYER_ENABLED=1

# How many items get listed per cycle. The auction house takes a few hours to
# fill at the default; raise it to populate faster at the cost of more work per
# tick.
AHBOT_ITEMS_PER_CYCLE=150

# Everything else in mod_ahbot.conf (pricing, category proportions, stack sizes)
# follows the same naming rule as above:
# AuctionHouseBot.SomeOption -> AC_AUCTION_HOUSE_BOT_SOME_OPTION.
# The one exception is AuctionHouseBot.GUIDs, which is managed automatically.
